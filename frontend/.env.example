# ─────────────────────────────────────────────────────────────
# FAiND Frontend — Environment Variables
# Copy this file to .env and fill in all values before running.
# Variables must be prefixed with VITE_ to be exposed to the client.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (leave blank to use the Vite proxy in development)
VITE_API_URL=

# ── Cloudinary (Feature C+) — image upload ──────────────────
# 1. Create a free account at https://cloudinary.com
# 2. Copy your Cloud Name from the dashboard
# 3. Go to Settings → Upload → Add upload preset
#    Name it (e.g. faind_items), set Signing Mode = Unsigned
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=faind_items

# Paystack public key (used in the tipping feature — Feature Q)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# VAPID public key for Web Push (Feature H)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
