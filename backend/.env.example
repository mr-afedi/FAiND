# ─────────────────────────────────────────────────────────────
# FAiND Backend — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────
APP_NAME=FAiND
APP_ENV=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────
# Supabase PostgreSQL connection string (or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/faind_db

# ── JWT ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-super-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption (AES-256-GCM) ───────────────────────────────────
# Generate with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-32-byte-base64url-encoded-key-here

# ── Cookie ─────────────────────────────────────────────────────
COOKIE_SECURE=false          # Set to true in production (requires HTTPS)
COOKIE_SAMESITE=lax

# ── Email / SMTP ───────────────────────────────────────────────
# Set EMAIL_CONSOLE_MODE=true to print emails to the console (no SMTP needed for dev)
EMAIL_CONSOLE_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@faind.app
SMTP_FROM_NAME=FAiND

# ── Frontend URL (for CORS + email links) ──────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Root Admin (used by seed_admin.py) ─────────────────────────
ROOT_ADMIN_EMAIL=admin@faind.app
ROOT_ADMIN_PASSWORD=ChangeMe123!
# Generate TOTP secret with: python -c "import pyotp; print(pyotp.random_base32())"
ROOT_ADMIN_TOTP_SECRET=YOUR_TOTP_SECRET_BASE32

# ── Paystack (Optional tipping — test mode for demo) ───────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Web Push (VAPID — for push notifications) ──────────────────
# Generate with: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key, v.public_key)"
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_CLAIMS_EMAIL=mailto:admin@faind.app
